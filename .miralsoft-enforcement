# MIRAL Soft enforcement configuration.
# Read by the git hooks in .git/hooks/ and by .github/workflows/content-checks.yml, which
# reads these same two keys so the local and the server-side check can never disagree about
# what is covered (R-17).

# R-03, R-19: the email is the same for every project; the name says which kind it is.
# The plugins and this index are private projects, so they commit as Sanaka. Declared in
# docs/project.md, which this file has to match.
OWNER_NAME=Sanaka
OWNER_EMAIL=20637644+miralsoft@users.noreply.github.com

# Files checked for em-dash characters (I-02). Everything hand-written here is prose meant
# for a person. Matched with `case`, where `*` also spans a slash, so `*.md` reaches every
# depth.
CONTENT_GLOBS=*.md *.json *.yml *.ps1

# Skipped even where the globs match. pluginmaster.json is generated from the manifests
# inside the plugin releases, so its prose is quoted from elsewhere (I-02) and belongs to
# the plugin that wrote it. Editing it here would falsify that text, and the next index run
# would overwrite the edit anyway. Where a plugin description needs different wording, it is
# fixed in the plugin repository. Recorded in docs/decisions.md.
CONTENT_EXCLUDE=pluginmaster.json
